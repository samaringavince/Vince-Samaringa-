public class Student extends Person {
    private String gradeLevel;

    //initializing name, id, and grade level//
    public Student(String name, int id, String gradeLevel) {
        super(name, id); // Call to the parent constructor
        this.gradeLevel = gradeLevel;
    }

    // overriding displayInfo to include grade level//
    @Override
    public void displayInfo() {
        super.displayInfo(); // Call to the parent displayInfo
        System.out.println("Grade Level: " + gradeLevel);
    }
}
