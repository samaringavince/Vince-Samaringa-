public class Person {
    private String name;
    private int id;

    //Initaliaze name & id//
    public Person(String name, int id) {
        this.name = name;
        this.id = id;
    }
}

///display information for name and id///
public void displayInfo() {
    System.out.println("name: "+ name);
    System.out.println("id: "+ id);

}